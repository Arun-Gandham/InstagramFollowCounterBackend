# ===================================================================
# Physical Instagram Follower Counter - Environment Configuration
# ===================================================================

# ASP.NET Core Runtime Environment (Development / Staging / Production)
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# PostgreSQL Database Connection
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=follower_counter_db;Username=follower_user;Password=CHANGE_ME_IN_PRODUCTION;

# AES-256-GCM Token Encryption Master Keys (32-byte Base64-encoded strings)
# Generate via: openssl rand -base64 32
SecretProtection__ActiveKeyId=key01
SecretProtection__Keys__key01=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# Official Meta Instagram Developer App Credentials
# Verification: Instagram API with Instagram Login for Professional Accounts
Meta__ClientId=CHANGE_TO_META_APP_ID
Meta__ClientSecret=CHANGE_TO_META_APP_SECRET
Meta__RedirectUri=https://api.example.com/api/v1/instagram/callback
Meta__ApiVersion=v22.0
Meta__AuthorizationUrl=https://www.instagram.com/oauth/authorize
Meta__TokenUrl=https://api.instagram.com/oauth/access_token
Meta__GraphBaseUrl=https://graph.instagram.com

# Instagram Provider: "Meta" for real production or "Fake" for offline local dev/testing
Instagram__Provider=Meta

# Email Provider: "Smtp" or "Console"
Email__Provider=Smtp
Email__SmtpHost=smtp.sendgrid.net
Email__SmtpPort=587
Email__EnableSsl=true
Email__SmtpUser=apikey
Email__SmtpPassword=CHANGE_TO_SENDGRID_OR_POSTMARK_KEY
Email__SenderEmail=no-reply@counter.example.com
Email__SenderName=Instagram Counter Support

# Allowed Frontend Origins for CORS (No wildcard in production!)
Cors__AllowedOrigins__0=https://counter.example.com

# Background Worker Settings
Workers__EnableFollowerRefresh=true
Workers__FollowerRefreshIntervalSeconds=30
Workers__FollowerRefreshBatchSize=20
Workers__FollowerRefreshMaxConcurrency=5
Workers__EnableTokenRefresh=true
Workers__TokenRefreshCheckIntervalHours=6
Workers__TokenRefreshDaysThreshold=7
Workers__EnableCleanup=true
Workers__CleanupIntervalHours=12
